{
  "name": "traqula-sparql-1-2-rewriter",
  "type": "module",
  "version": "0.0.0",
  "private": "true",
  "packageManager": "yarn@1.22.22",
  "description": "Query rewriting for a SPARQL 1.2 query on RDF 1.1 data ",
  "lsd:module": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jitsedesmet/2025-query-rewriting-1-2"
  },
  "bugs": {
    "url": "https://github.com/jitsedesmet/2025-query-rewriting-1-2/issues"
  },
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    }
  },
  "main": "lib/index.js",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib/**/*.cjs",
    "lib/**/*.d.ts",
    "lib/**/*.js",
    "lib/**/*.js.map"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "typings": "lib/index",
  "scripts": {
    "build": "yarn build:ts && yarn build:transpile",
    "build:ts": "node \"node_modules/typescript/bin/tsc\"",
    "build:transpile": "node \"node_modules/esbuild/bin/esbuild\" --format=cjs --bundle --log-level=error --outfile=lib/index.cjs lib/index.ts",
    "clean": "git clean -dfx",
    "doc": "typedoc",
    "lint": "eslint . --cache",
    "postinstall": "yarn husky && yarn run build",
    "test": "vitest test --run"
  },
  "dependencies": {
    "@traqula/algebra-sparql-1-2": "^0.0.24",
    "@traqula/algebra-transformations-1-2": "^0.0.24",
    "@traqula/generator-sparql-1-2": "^0.0.24",
    "@traqula/parser-sparql-1-2": "^0.0.24",
    "@traqula/rules-sparql-1-2": "^0.0.24",
    "rdf-data-factory": "^2.0.2"
  },
  "devDependencies": {
    "@comunica/query-sparql-file": "4.4.2-alpha.49.0",
    "@rdfjs/types": "^2.0.0",
    "@rubensworks/eslint-config": "^3.1.0",
    "@vitest/coverage-v8": "3.2.4",
    "esbuild": "^0.25.0",
    "eslint": "^8.57.0",
    "husky": "^9.1.7",
    "n3": "2.0.0-beta.1",
    "rdf-isomorphic": "^2.0.1",
    "rdf-string": "^2.0.1",
    "rdf-terms": "^2.0.1",
    "typedoc": "^0.28.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.5"
  }
}
