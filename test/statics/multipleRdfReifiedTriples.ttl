PREFIX : <ex://>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

# Base facts
:alice :knows :bob .
:alice :knows :charlie .
:bob :knows :dave .
:alice :age 30 .

# Reified triple 1: Alice knows Bob, stated by Wikipedia with high confidence
:t1 a rdf:Statement .
:t1 rdf:Subject :alice .
:t1 rdf:Predicate :knows .
:t1 rdf:Object :bob .
:t1 :statedBy :wikipedia .
:t1 :confidence "0.9" .

# Reified triple 2: Alice knows Charlie, stated by a survey
:t2 a rdf:Statement .
:t2 rdf:Subject :alice .
:t2 rdf:Predicate :knows .
:t2 rdf:Object :charlie .
:t2 :statedBy :survey .
:t2 :confidence "0.7" .

# Reified triple 3: Bob knows Dave, stated by Alice
:t3 a rdf:Statement .
:t3 rdf:Subject :bob .
:t3 rdf:Predicate :knows .
:t3 rdf:Object :dave .
:t3 :statedBy :alice .
