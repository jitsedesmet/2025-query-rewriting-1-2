{
  "compileOnSave": true,
  "compilerOptions": {
    "composite": true,
    "target": "es2022",
    "lib": [
      "es2022",
      "dom"
    ],
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "types": ["vitest/globals"],
    "strict": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": false,
    "noImplicitOverride": true,
    "declaration": true,
    "downlevelIteration": true,
    "inlineSources": true,
    "preserveConstEnums": true,
    "removeComments": false,
    "sourceMap": true,

    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "references": [
    { "path": "../traqula/engines/generator-sparql-1-2" },
    { "path": "../traqula/packages/rules-sparql-1-1" },
    { "path": "../traqula/packages/rules-sparql-1-2" },
    { "path": "../traqula/packages/core" }
  ],
  "include": [
    "lib/**/*.ts",
    "test/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
